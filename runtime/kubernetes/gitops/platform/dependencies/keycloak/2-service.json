{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "keycloak",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "0"
    }
  },
  "spec": {
    "selector": {
      "app": "keycloak"
    },
    "ports": [
      {
        "name": "http",
        "port": 8080,
        "targetPort": 8080
      }
    ]
  }
}
