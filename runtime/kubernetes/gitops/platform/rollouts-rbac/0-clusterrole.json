{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "ClusterRole",
  "metadata": {
    "name": "teck-local-rollouts-gateway",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "0"
    }
  },
  "rules": [
    {
      "apiGroups": [
        "gateway.networking.k8s.io"
      ],
      "resources": [
        "httproutes"
      ],
      "verbs": [
        "get",
        "list",
        "update",
        "patch"
      ]
    }
  ]
}
