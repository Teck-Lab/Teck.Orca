{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "git",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "0"
    }
  },
  "spec": {
    "type": "NodePort",
    "selector": {
      "app": "teck-local-git"
    },
    "ports": [
      {
        "name": "http",
        "port": 9418,
        "targetPort": 8080,
        "nodePort": 30418
      }
    ]
  }
}
