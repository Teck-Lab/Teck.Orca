{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "git",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "0"
    }
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "teck-local-git"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "teck-local-git"
        }
      },
      "spec": {
        "securityContext": {
          "runAsUser": 999,
          "runAsGroup": 999,
          "fsGroup": 999
        },
        "containers": [
          {
            "name": "git",
            "image": "quay.io/argoproj/argocd:v3.5.6",
            "command": [
              "sh",
              "-c"
            ],
            "args": [
              "set -eu; for repo in apps gitops; do test -d /repos/$repo.git || git init --bare --initial-branch=main /repos/$repo.git; git --git-dir=/repos/$repo.git config http.receivepack true; done; exec perl /scripts/git-http.pl"
            ],
            "env": [
              {
                "name": "GIT_CONFIG_GLOBAL",
                "value": "/dev/null"
              },
              {
                "name": "GIT_CONFIG_SYSTEM",
                "value": "/dev/null"
              }
            ],
            "ports": [
              {
                "name": "http",
                "containerPort": 8080
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8080
              }
            },
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "32Mi"
              },
              "limits": {
                "memory": "256Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/repos"
              },
              {
                "name": "http-script",
                "mountPath": "/scripts",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "git-data"
            }
          },
          {
            "name": "http-script",
            "configMap": {
              "name": "local-git-http"
            }
          }
        ]
      }
    }
  }
}
