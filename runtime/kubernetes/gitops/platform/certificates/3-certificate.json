{
  "apiVersion": "cert-manager.io/v1",
  "kind": "Certificate",
  "metadata": {
    "name": "local-ingress",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "0"
    }
  },
  "spec": {
    "secretName": "local-ingress-tls",
    "dnsNames": [
      "*.teck.test"
    ],
    "issuerRef": {
      "name": "local-ca",
      "kind": "Issuer"
    }
  }
}
