{
  "vars": [
    {
      "name": "appRepo",
      "value": "__APP_REPO__"
    },
    {
      "name": "gitopsRepo",
      "value": "__GITOPS_REPO__"
    }
  ],
  "steps": [
    {
      "uses": "git-clone",
      "config": {
        "repoURL": "${{ vars.gitopsRepo }}",
        "checkout": [
          {
            "branch": "main",
            "path": "./gitops"
          }
        ]
      }
    },
    {
      "uses": "yaml-update",
      "config": {
        "path": "./gitops/applications/__WORKTREE__/kustomization.yaml",
        "updates": [
          {
            "key": "resources.0",
            "value": "__APP_REPO__//promotion?ref=${{ commitFrom(vars.appRepo).ID }}"
          }
        ]
      }
    },
    {
      "uses": "git-commit",
      "as": "commit",
      "config": {
        "path": "./gitops",
        "message": "chore(local): promote __WORKTREE__"
      }
    },
    {
      "uses": "git-push",
      "config": {
        "path": "./gitops"
      }
    },
    {
      "uses": "argocd-update",
      "config": {
        "apps": [
          {
            "name": "__APPLICATION__",
            "namespace": "argocd",
            "sources": [
              {
                "repoURL": "__GITOPS_REPO__",
                "desiredRevision": "${{ outputs.commit.commit }}"
              }
            ]
          }
        ]
      },
      "retry": {
        "errorThreshold": 3,
        "timeout": "6m"
      }
    }
  ]
}
