{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://mcp.tecklab.dk/mcp/github?features=issue_dependencies",
      "headers": {
        "Authorization": "Bearer ${MCPHUB_API_KEY}"
      },
      "timeout": 120000
    },
    "github-projects": {
      "type": "http",
      "url": "https://mcp.tecklab.dk/mcp/github-projects",
      "headers": { "Authorization": "Bearer ${MCPHUB_API_KEY}" },
      "timeout": 120000
    },
    "searxng": {
      "type": "http",
      "url": "https://mcp.tecklab.dk/mcp/searxng",
      "headers": {
        "Authorization": "Bearer ${MCPHUB_API_KEY}"
      },
      "timeout": 120000
    }
  }
}


